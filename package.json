{
  "name": "gyaan-setu-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "Offline multilingual educational PWA with an on-device AI tutor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css,json}\" \"scripts/**/*.js\" \"tests/**/*.js\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.js",
    "import:images": "node scripts/import-lesson-images.js",
    "import:images:check": "node scripts/import-lesson-images.js --check",
    "split:model": "node scripts/split-model.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
